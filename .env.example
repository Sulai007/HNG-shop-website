# ==============================================================================
# ÈDÁ Artisanal Living — Environment Configuration
# Copy this file to .env and fill in your actual production/staging values.
# NEVER commit .env to GitHub or version control.
# ==============================================================================

# Application URL (AI Studio Cloud Run URL or custom production domain)
APP_URL="http://localhost:3000"
PORT=3000

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# Find these in your Supabase Project Settings -> API
# ------------------------------------------------------------------------------
# Supabase Project URL (e.g., https://your-project.supabase.co)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Anon / Public Key (Safe for browser client)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# RESEND TRANSACTIONAL EMAIL CONFIGURATION
# Find your API key at https://resend.com/api-keys
# ------------------------------------------------------------------------------
# Resend API Key (Server-side ONLY, never exposed to client)
RESEND_API_KEY="re_123456789_abcdef..."

# Verified Sender Email (e.g. orders@yourdomain.com or onboarding@resend.dev for testing)
RESEND_FROM_EMAIL="ÈDÁ Artisanal Living <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# GOOGLE OAUTH CONFIGURATION
# Configured directly in Supabase Dashboard -> Authentication -> Providers -> Google
# (No client secrets needed in frontend environment)
# ------------------------------------------------------------------------------
